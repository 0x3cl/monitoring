APP_NAME=SENTINEL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sentinel
DB_USERNAME=sentinel
DB_TIMEZONE=UTC
DB_PASSWORD=sentinel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SENTINEL_MAX_BODY_BYTES=262144
SENTINEL_MAX_BATCH_EVENTS=100
SENTINEL_RATE_LIMIT_PER_MINUTE=600
SENTINEL_SLOW_REQUEST_MS=3000
SENTINEL_ERROR_RATE_PERCENT=5
SENTINEL_DISCONNECT_AFTER_MINUTES=15

# Outbound heartbeat probing. Probes run on their own queue, so a worker must
# consume it: php artisan queue:work --queue=heartbeat,default
SENTINEL_HEARTBEAT_ENABLED=true
SENTINEL_HEARTBEAT_QUEUE=heartbeat
SENTINEL_HEARTBEAT_INTERVAL=60
SENTINEL_HEARTBEAT_FAILURE_THRESHOLD=2
SENTINEL_HEARTBEAT_JITTER_PERCENT=10
SENTINEL_HEARTBEAT_DISPATCH_CHUNK=500
SENTINEL_HEARTBEAT_CONNECT_TIMEOUT=3
SENTINEL_HEARTBEAT_TIMEOUT=5
SENTINEL_HEARTBEAT_TCP_TIMEOUT=3
SENTINEL_HEARTBEAT_SLOW_RESPONSE_MS=2000
SENTINEL_HEARTBEAT_VERIFY_MAINTENANCE=true
SENTINEL_HEARTBEAT_HEALTH_PATH=/up
SENTINEL_HEARTBEAT_SERVER_PORT=443
SENTINEL_RETENTION_EVENT_DAYS=30
SENTINEL_RETENTION_TRAFFIC_DAYS=365

# Traffic analytics. Client addresses are personal data: set
# SENTINEL_TRAFFIC_MASK_IP=true to store them with the last octet dropped.
SENTINEL_TRAFFIC_ENABLED=true
SENTINEL_TRAFFIC_QUEUE=aggregates
SENTINEL_TRAFFIC_STORE_IP=true
SENTINEL_TRAFFIC_MASK_IP=false
SENTINEL_TRAFFIC_TOP_N=10
SENTINEL_TRAFFIC_RECOMPUTE_DAYS=2

# Composer repository that serves the integration agents.
# Set SENTINEL_PACKAGES_URL when the public URL differs from APP_URL.
SENTINEL_PACKAGES_PUBLIC=true
SENTINEL_PACKAGES_URL=
