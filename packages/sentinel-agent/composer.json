{
    "name": "dost-ptri/sentinel-agent",
    "description": "SENTINEL monitoring agent for Laravel applications",
    "type": "library",
    "version": "1.2.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DostPtri\\SentinelAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DostPtri\\SentinelAgent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DostPtri\\SentinelAgent\\SentinelServiceProvider"
            ],
            "aliases": {
                "Sentinel": "DostPtri\\SentinelAgent\\Facades\\Sentinel"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
